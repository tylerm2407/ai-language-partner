# Supabase
EXPO_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# AI Backend (called via Supabase Edge Functions, not directly from client)
# AI_API_KEY is stored in Supabase Edge Function secrets, NOT here
EXPO_PUBLIC_AI_ENDPOINT=https://your-project-id.supabase.co/functions/v1/ai-chat

# RevenueCat (in-app purchases) — public SDK keys from app.revenuecat.com
# iOS key starts with "appl_", Android key starts with "goog_"
EXPO_PUBLIC_REVENUECAT_IOS_KEY=appl_your-ios-public-key
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=goog_your-android-public-key

# Sentry (crash reporting) — DSN from sentry.io
EXPO_PUBLIC_SENTRY_DSN=https://your-sentry-dsn-here

# PostHog — use different projects so development traffic cannot contaminate
# production funnels. Leave the non-production key unset to disable analytics
# in local/preview builds.
EXPO_PUBLIC_POSTHOG_KEY=phc_your-production-project-token
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
EXPO_PUBLIC_POSTHOG_NON_PRODUCTION_KEY=phc_your-development-project-token
EXPO_PUBLIC_POSTHOG_NON_PRODUCTION_HOST=https://us.i.posthog.com

# Edge Function secret used for authoritative billing lifecycle events. This
# is the same public project token as EXPO_PUBLIC_POSTHOG_KEY, configured with
# `supabase secrets set` rather than bundled into the server source.
POSTHOG_API_KEY=phc_your-production-project-token
POSTHOG_HOST=https://us.i.posthog.com

# App Config
EXPO_PUBLIC_APP_ENV=development
