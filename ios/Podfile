require File.join(File.dirname(`node --print "require.resolve('expo/package.json')"`), "scripts/autolinking")
require File.join(File.dirname(`node --print "require.resolve('react-native/package.json')"`), "scripts/react_native_pods")

require 'json'
podfile_properties = JSON.parse(File.read(File.join(__dir__, 'Podfile.properties.json'))) rescue {}

def ccache_enabled?(podfile_properties)
  # Environment variable takes precedence
  return ENV['USE_CCACHE'] == '1' if ENV['USE_CCACHE']
  
  # Fall back to Podfile properties
  podfile_properties['apple.ccacheEnabled'] == 'true'
end

ENV['RCT_NEW_ARCH_ENABLED'] ||= '0' if podfile_properties['newArchEnabled'] == 'false'
ENV['EX_DEV_CLIENT_NETWORK_INSPECTOR'] ||= podfile_properties['EX_DEV_CLIENT_NETWORK_INSPECTOR']
ENV['RCT_USE_RN_DEP'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'
ENV['RCT_USE_PREBUILT_RNCORE'] ||= '1' if podfile_properties['ios.buildReactNativeFromSource'] != 'true' && podfile_properties['newArchEnabled'] != 'false'

# Prebuilt React Native core from the local cache when the download is broken.
#
# React Native decides whether the prebuilt core exists with a `curl -I`
# against Maven. Since 2026-09-09 that request 301s to repo.reactnative.dev,
# which answers 404 for the 0.81.5 tarballs, so a plain `pod install` logged
# "No prebuilt artifacts found, reverting to building from source", rewrote
# Podfile.lock onto boost/fmt/glog source pods, and the Debug build then died
# in fmt under Xcode 26. The tarballs a previous install downloaded are still
# under Pods/, and React Native accepts a local path for each — this points it
# there whenever the file is present. On a machine without the cache (EAS)
# nothing is set and behaviour is unchanged. Drop this block once the Maven
# download works again. NOTE: `expo prebuild` regenerates this file; keep the
# block if that ever runs.
if ENV['RCT_USE_PREBUILT_RNCORE'] == '1'
  rn_version = JSON.parse(File.read(File.join(__dir__, '..', 'node_modules', 'react-native', 'package.json')))['version'] rescue nil
  if rn_version
    core_tarball = File.join(__dir__, 'Pods', 'ReactNativeCore-artifacts', "reactnative-core-#{rn_version}-debug.tar.gz")
    deps_tarball = File.join(__dir__, 'Pods', 'ReactNativeDependencies-artifacts', "reactnative-dependencies-#{rn_version}-debug.tar.gz")
    ENV['RCT_TESTONLY_RNCORE_TARBALL_PATH'] ||= core_tarball if File.exist?(core_tarball)
    ENV['RCT_USE_LOCAL_RN_DEP'] ||= deps_tarball if File.exist?(deps_tarball)
  end
end
platform :ios, podfile_properties['ios.deploymentTarget'] || '15.1'

prepare_react_native_project!

target 'Fluenci' do
  use_expo_modules!

  if ENV['EXPO_USE_COMMUNITY_AUTOLINKING'] == '1'
    config_command = ['node', '-e', "process.argv=['', '', 'config'];require('@react-native-community/cli').run()"];
  else
    config_command = [
      'node',
      '--no-warnings',
      '--eval',
      'require(\'expo/bin/autolinking\')',
      'expo-modules-autolinking',
      'react-native-config',
      '--json',
      '--platform',
      'ios'
    ]
  end

  config = use_native_modules!(config_command)

  use_frameworks! :linkage => podfile_properties['ios.useFrameworks'].to_sym if podfile_properties['ios.useFrameworks']
  use_frameworks! :linkage => ENV['USE_FRAMEWORKS'].to_sym if ENV['USE_FRAMEWORKS']

  use_react_native!(
    :path => config[:reactNativePath],
    :hermes_enabled => podfile_properties['expo.jsEngine'] == nil || podfile_properties['expo.jsEngine'] == 'hermes',
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/..",
    :privacy_file_aggregation_enabled => podfile_properties['apple.privacyManifestAggregationEnabled'] != 'false',
  )

  post_install do |installer|
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      :ccache_enabled => ccache_enabled?(podfile_properties),
    )

    # Raise every pod to the app's own deployment target.
    #
    # Six pods ship podspecs written against iOS 9.0-13.4 (RNCAsyncStorage,
    # RevenueCat, SDWebImage, PurchasesHybridCommon, RNSVG, ReachabilitySwift).
    # Xcode 26 warned about those; Xcode 27 refuses them outright — "the range
    # of supported deployment target versions is 15.0 to 27.0.x" — and the
    # simulator build fails before compiling a line of our code. Nothing here
    # supports iOS 14: the app target is 15.1 and the `platform :ios` line above
    # is 15.1, so the old floors only ever described what those pods COULD run
    # on, never what this app ships to.
    #
    # Both loops are needed. `pods_project` carries the pod targets themselves;
    # `generated_projects` carries the per-pod resource-bundle projects that
    # newer CocoaPods splits out, and the first error Xcode 27 reported was from
    # one of those (RNCAsyncStorage-RNCAsyncStorage_resources).
    #
    # Only raises, never lowers: a pod that already asks for more than 15.1
    # keeps what it asked for.
    deployment_target = podfile_properties['ios.deploymentTarget'] || '15.1'
    raise_target = lambda do |config|
      current = config.build_settings['IPHONEOS_DEPLOYMENT_TARGET']
      if current.nil? || Gem::Version.new(current) < Gem::Version.new(deployment_target)
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = deployment_target
      end
    end

    installer.pods_project.targets.each do |target|
      target.build_configurations.each { |config| raise_target.call(config) }
    end
    installer.generated_projects.each do |project|
      project.targets.each do |target|
        target.build_configurations.each { |config| raise_target.call(config) }
      end
    end
  end
end
