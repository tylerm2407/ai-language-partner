node_modules/
# ...and as a bare path, so a SYMLINK named node_modules cannot slip through the
# way it did in 77f2cf5 (a self-referential link that broke every install).
node_modules
.expo/
dist/
credentials/
google-play-service-account.json
*-service-account.json
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*
web-build/
coverage/
.env
.env.local

# Claude Code local settings
.claude/settings.local.json

# Claude tooling artifacts — machine-local state, not project config.
# .claude/ is otherwise tracked (skills, rules), so these are named
# individually rather than ignoring the directory.
.claude-flow/
# Agent worktrees. These are full git worktrees created INSIDE the repo, so
# without this a `git add -A` commits three copies of the tree — and jest and
# eslint traverse them as if they were source.
.claude/worktrees/
.claude/proven-config.json
.claude/.proven-config-version

# Playwright MCP testing cache
.playwright-mcp/

# Supabase temp/cache and secrets
supabase/.temp/
supabase/__pycache__/
supabase/.env
supabase/functions/.env

